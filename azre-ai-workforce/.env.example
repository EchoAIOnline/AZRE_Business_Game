OPENAI_API_KEY=
OPENAI_MODEL=
DEALDESK_PLUGIN_URL=https://dealdesk.asharizakargroup.com/api/ai/plugin
DEALDESK_PLUGIN_API_KEY=
STATUS_API_TOKEN=
STATE_DB=data/operations.sqlite
REPORT_DIR=data/reports
HOST=127.0.0.1
PORT=3101
SCHEDULE_ENABLED=false
AUDIT_CRON=0 8 * * *
BRIEFING_CRON=0 17 * * *
TRACING_ENABLED=false

# Chat credentials stay server-side. Local dev may reuse parent office password.
CHAT_ACCESS_PASSWORD=
CHAT_USER_ID=ceo
CHAT_DAILY_TOKEN_LIMIT=400000
CHAT_TURN_TOKEN_LIMIT=80000
CHAT_MAX_CONCURRENT=2
COOKIE_SECURE=false
# Explicit chat context/retrieval limits; total per-turn/daily budgets unchanged.
CHAT_INPUT_TOKEN_LIMIT=16000
CHAT_OUTPUT_TOKEN_LIMIT=2000
CHAT_MAX_TOOL_CALLS=8
CHAT_TOOL_RESPONSE_BYTES=14000
CHAT_HISTORY_MESSAGES=12
CHAT_HISTORY_CHARS=6000

# Detailed report output only; total turn/input/daily limits remain unchanged.
CHAT_REPORT_OUTPUT_TOKEN_LIMIT=3200

# Local read-only corporate knowledge; no external embeddings.
KNOWLEDGE_ENABLED=false
KNOWLEDGE_CONFIG=config/knowledge.json
KNOWLEDGE_DB=data/knowledge.sqlite
